<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- 演示环境：指向同目录 mock_server.py 启动的本地模拟服务（默认端口 18080） -->
    <add key="ServerUrl" value="http://127.0.0.1:18080/K3Cloud/" />
    <!-- 数据中心（账套）ID：模拟服务不校验，任意非空值均可 -->
    <add key="AcctId" value="DEMO0001" />
    <!-- 模拟账号：Administrator / demo123（与 mock_server.py 顶部 MOCK_USER/MOCK_PASSWORD 一致） -->
    <add key="UserName" value="Administrator" />
    <add key="Password" value="demo123" />
    <!-- 语言：2052=简体中文 -->
    <add key="Lcid" value="2052" />

    <!-- 以下为“新建采购订单”场景用到的基础资料编号（模拟服务不校验，与预置演示数据对齐即可） -->
    <add key="OrgNumber" value="100" />
    <add key="SupplierNumber" value="VEN001" />
    <add key="MaterialNumber" value="M001" />
    <add key="BillTypeNumber" value="CGDD01_SYS" />

    <!-- 菜单 5 自定义单据“差旅费报销单 SKY_ExpReimburse”可选字段：部门/员工编号，留空则不传 -->
    <add key="DeptNumber" value="" />
    <add key="EmpNumber" value="" />
  </appSettings>
</configuration>