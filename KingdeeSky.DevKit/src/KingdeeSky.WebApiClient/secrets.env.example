# ============================================================
# secrets.env.example —— 密钥环境变量模板
# ------------------------------------------------------------
# 用法：
#   1. 复制本文件为 secrets.env（已 .gitignore，禁止提交）；
#   2. 按环境填入真实密钥值；
#   3. App.config 中 SecretStore=file 且 SecretsFile 指向本文件时会被读取；
#      也可以不落盘，直接在进程/用户/机器级环境变量中设置同名变量（SecretStore=env）。
# 原则：密钥只存在于本机环境或密钥服务，绝不写入 App.config / 源码 / 提交历史。
# ============================================================

# 账号密码鉴权（AuthMode=password）：WebAPI 用户密码
KINGDEE_PASSWORD=

# OAuth 2.0 客户端（AuthMode=oauth2）：client_id / client_secret
KINGDEE_CLIENT_ID=
KINGDEE_CLIENT_SECRET=

# AppID/AppSec 签名（AuthMode=appsec，按版本支持后启用）
KINGDEE_APP_ID=
KINGDEE_APP_SECRET=

# 密钥服务（SecretStore=kms）访问令牌
KINGDEE_KMS_TOKEN=