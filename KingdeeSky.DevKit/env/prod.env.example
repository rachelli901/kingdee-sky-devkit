# KingdeeSky.DevKit - environment template: prod
# Non-sensitive overrides only. Secrets (KINGDEE_*) stay in the secret source
# (env vars / secrets file / DPAPI / KMS), never in this file.
# Copy to env/prod.env on the deploy server and load via:
#   powershell -File eng/run-env.ps1 -Environment prod
# Production recommendations:
#   - HTTPS only (KDSKY_ALLOW_INSECURE_HTTP=false, KDSKY_ALLOW_INVALID_CERT=false)
#   - Secrets via DPAPI or KMS (KDSKY_SECRET_STORE=dpapi) under a service account
#   - Consider appsec (AppID+AppSec signature) or oauth2 once the K3Cloud side
#     token endpoint is verified; configure AppSecSigningTemplate/TokenEndpoint
#     in App.config (non-sensitive format/switch keys).
KDSKY_ENV=prod
KDSKY_SERVER_URL=https://erp.corp.example/K3Cloud/
KDSKY_ACCT_ID=PRODACCT
KDSKY_USER_NAME=WebApiSvc
KDSKY_AUTH_MODE=password
KDSKY_SECRET_STORE=dpapi
KDSKY_ALLOW_INSECURE_HTTP=false
KDSKY_ALLOW_INVALID_CERT=false