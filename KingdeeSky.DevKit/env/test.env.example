# KingdeeSky.DevKit - environment template: test
# Non-sensitive overrides only. Secrets (KINGDEE_*) stay in the secret source
# (env vars / secrets file / DPAPI / KMS), never in this file.
# Copy to env/test.env and load via: powershell -File eng/run-env.ps1 -Environment test
KDSKY_ENV=test
KDSKY_SERVER_URL=https://test.kdcloud.example/K3Cloud/
KDSKY_ACCT_ID=TESTACCT
KDSKY_USER_NAME=Operator
KDSKY_AUTH_MODE=password
KDSKY_SECRET_STORE=env
KDSKY_ALLOW_INSECURE_HTTP=false
KDSKY_ALLOW_INVALID_CERT=false