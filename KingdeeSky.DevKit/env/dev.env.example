# KingdeeSky.DevKit - environment template: dev
# Non-sensitive overrides only. Secrets (KINGDEE_*) stay in the secret source
# (env vars / secrets file / DPAPI / KMS), never in this file.
# Copy to env/dev.env and load via: powershell -File eng/run-env.ps1 -Environment dev
KDSKY_ENV=dev
KDSKY_SERVER_URL=http://127.0.0.1:18080/K3Cloud/
KDSKY_ACCT_ID=DEMO
KDSKY_USER_NAME=Administrator
KDSKY_AUTH_MODE=password
KDSKY_SECRET_STORE=env
KDSKY_ALLOW_INSECURE_HTTP=true
KDSKY_ALLOW_INVALID_CERT=false